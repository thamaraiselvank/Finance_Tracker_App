# Finverse Personal Finance App Environment Variables
ENVIRONMENT=development
SECRET_KEY=replace-this-with-a-unique-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL Connection Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance_tracker

# Pool Settings
PG_MIN_POOL_SIZE=1
PG_MAX_POOL_SIZE=5

# Comma-separated frontend origins are not supported; provide a JSON array.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Gemini on Vertex AI. Local development uses gcloud ADC; Cloud Run uses its service account.
GEMINI_ENABLED=true
GEMINI_PROJECT=finance-tracker-app-512203
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=2000
# Optional multimodal PDF extraction (only used when selected in the import UI).
IMPORT_GEMINI_ENABLED=true
IMPORT_GEMINI_MAX_PAGES=20
IMPORT_GEMINI_MAX_ROWS=1000
IMPORT_GEMINI_MAX_OUTPUT_TOKENS=12000
# Optional absolute path; defaults to backend/app/data/ai_guardrails.json
# AI_GUARDRAILS_FILE=

# AI usage limits. One Gemini-backed user question uses one daily request.
AI_DAILY_REQUEST_LIMIT=30
AI_QUOTA_TIMEZONE=Asia/Kolkata
AI_BURST_REQUESTS_PER_MINUTE=5
AI_BURST_WINDOW_SECONDS=60
